  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 'tests/unit/**/*.test.ts' 'tests/contract/**/*.test.ts' 'tests/integration/**/*.test.ts' 'tests/security/**/*.test.ts'",
