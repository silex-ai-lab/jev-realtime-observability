# Copy to .env (git-ignored) and fill in. Never commit real keys.
PORT=8787
HOST=127.0.0.1
# DATABASE_URL=postgres://silex:silex@localhost:5432/silex   # omit to use embedded PGlite in DATA_DIR
DATA_DIR=.data/pg
TENANT_ID=t-demo
INGEST_KEY=change-me-ingest-0000000000
READER_KEY=change-me-reader-0000000000
GATEWAY_KEY=change-me-gateway-000000000
ADMIN_KEY=change-me-admin-00000000000
# Judge: kev-local (default; open Kev model served by scripts/kev-serve.sh), typesafe (hosted Jev; needs a key) or none
JUDGE_BACKEND=kev-local
JUDGE_BASE_URL=http://127.0.0.1:8009
JUDGE_MODEL=kev-latest
JUDGE_EXPECTED_RUN=jaredpalmer/kev-4b
# TYPESAFE_API_KEY=
