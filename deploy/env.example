# Copy to .env (git-ignored) and fill in. Never commit real keys.
PORT=8787
HOST=127.0.0.1
# DATABASE_URL=postgres://silex:silex@localhost:5432/silex   # omit to use embedded PGlite in DATA_DIR
DATA_DIR=.data/pg
TENANT_ID=t-demo
# Authentication (login) is OPTIONAL and OFF by default.
#   AUTH_MODE=none : no keys; anyone who can reach the port has full access (the server refuses a
#                    non-loopback HOST in this mode unless ALLOW_UNAUTHENTICATED_REMOTE=1).
#   AUTH_MODE=keys : every /v1 call needs one of the keys below (reader, admin, ingest or gateway role).
AUTH_MODE=none
# The keys are only used with AUTH_MODE=keys (set four different random values: openssl rand -hex 24).
INGEST_KEY=change-me-ingest-0000000000
READER_KEY=change-me-reader-0000000000
GATEWAY_KEY=change-me-gateway-000000000
ADMIN_KEY=change-me-admin-00000000000
# Judge: kev-local (default; open Kev model served by scripts/kev-serve.sh), typesafe (hosted Jev; needs a key) or none
JUDGE_BACKEND=kev-local
JUDGE_BASE_URL=http://127.0.0.1:8009
JUDGE_MODEL=kev-latest
JUDGE_EXPECTED_RUN=jaredpalmer/kev-4b
# TYPESAFE_API_KEY=
# Gate C (sandbox pre-tool gate). Enforce with SOURCE_MODE=live_sandbox_gate.
# The gate judge must fit a 400 ms budget AND must not share an accelerator with the shadow judge:
# on one Apple GPU, run the gate with JUDGE_BACKEND=none for shadow, or put the gate judge on its own hardware.
# SOURCE_MODE=live_sandbox_gate
# GATE_JUDGE_BASE_URL=http://127.0.0.1:8010
# GATE_JUDGE_EXPECTED_RUN=jaredpalmer/kev-0.8b
# Sandbox fault injection (F1's 1 ms judge-budget drill). OFF by default; set FAULT_INJECTION=1 to enable
# the F1 scenario's deliberate judge timeout. Leave unset in normal operation.
# FAULT_INJECTION=1
